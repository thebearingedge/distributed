# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM ghcr.io/thebearingedge/rust-builder:default AS rust-builder

ARG TARGETARCH
ARG APPLICATION

COPY --chown=65534:65534 . .

RUN \
  test -n "$APPLICATION" || { echo "build arg APPLICATION is required" >&2; exit 1; } \
  && T="$(rust-target "$TARGETARCH")" \
  && cargo build --release --locked --target "$T" -p "$APPLICATION" \
  && cp "target/$T/release/$APPLICATION" /app/target/app


FROM gcr.io/distroless/cc-debian12

COPY --from=rust-builder /app/target/app /app

USER 65534:65534

ENTRYPOINT ["/app"]
